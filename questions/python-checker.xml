<qtest><testcase>3</testcase><testinput><name>ans</name><value>-d</value></testinput><expected><name>prt1</name><expectedscore>0</expectedscore><expectedpenalty>0.1</expectedpenalty><expectedanswernote>multiple-F</expectedanswernote></expected></qtest>
