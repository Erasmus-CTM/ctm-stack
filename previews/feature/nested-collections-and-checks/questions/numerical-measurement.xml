<quiz>
  <question type="stack">
    <name>
      <text>Rectangle and triangle measurements</text>
    </name>
    <questiontext format="html">
      <text>&lt;p&gt;A rectangle is \({@p@}\) cm long and \({@q@}\) cm wide. A right triangle has those same perpendicular side lengths.&lt;/p&gt;&lt;ol&gt;&lt;li&gt;Find the rectangle perimeter in cm, within \(0.25\) cm. [[input:perimeter]] [[validation:perimeter]] [[feedback:prt1]]&lt;/li&gt;&lt;li&gt;Find the triangle area in cm², within \(2\%\) of the exact value. [[input:area]] [[validation:area]] [[feedback:prt2]]&lt;/li&gt;&lt;li&gt;Write the triangle area to &lt;strong&gt;exactly two decimal places&lt;/strong&gt; (include the final zero). [[input:reported]] [[validation:reported]] [[feedback:prt3]]&lt;/li&gt;&lt;/ol&gt;</text>
    </questiontext>
    <generalfeedback format="html">
      <text>&lt;p&gt;Perimeter: \(2({@p@}+{@q@})={@ta_perimeter@}\) cm. Triangle area: \({@p@}\cdot{@q@}/2={@ta_area@}\) cm². To two decimal places, write &lt;strong&gt;17.50&lt;/strong&gt;; the final zero records the requested precision.&lt;/p&gt;</text>
    </generalfeedback>
    <defaultgrade>1</defaultgrade>
    <penalty>0.1</penalty>
    <hidden>0</hidden>
    <idnumber/>
    <stackversion>
      <text>2021072200</text>
    </stackversion>
    <questionvariables>
      <text>p:7;
q:5;
ta_perimeter:2*(p+q);
ta_area:p*q/2;</text>
    </questionvariables>
    <specificfeedback format="html">
      <text>&lt;p&gt;[[feedback:prt1]] [[feedback:prt2]] [[feedback:prt3]]&lt;/p&gt;</text>
    </specificfeedback>
    <questionnote format="moodle_auto_format">
      <text>Numerical checks: perimeter 24, area 17.5, two-place area 17.50</text>
    </questionnote>
    <questiondescription format="moodle_auto_format">
      <text/>
    </questiondescription>
    <questionsimplify>1</questionsimplify>
    <assumepositive>0</assumepositive>
    <assumereal>0</assumereal>
    <scientificnotation>*10</scientificnotation>
    <multiplicationsign>none</multiplicationsign>
    <sqrtsign>1</sqrtsign>
    <complexno>i</complexno>
    <inversetrig>cos-1</inversetrig>
    <logicsymbol>lang</logicsymbol>
    <matrixparens>[</matrixparens>
    <isbroken>0</isbroken>
    <variantsselectionseed/>
    <input>
      <name>perimeter</name>
      <type>numerical</type>
      <tans>ta_perimeter</tans>
      <boxsize>18</boxsize>
      <strictsyntax>1</strictsyntax>
      <insertstars>0</insertstars>
      <syntaxhint/>
      <syntaxattribute>0</syntaxattribute>
      <forbidwords/>
      <allowwords/>
