      <mustverify>1</mustverify>
      <showvalidation>1</showvalidation>
      <options/>
    </input>
    <input>
      <name>reported</name>
      <type>numerical</type>
      <tans>ta_area</tans>
      <boxsize>18</boxsize>
      <strictsyntax>1</strictsyntax>
